# oxienv.toml — generated by oxidized-environment
# Canonical Zainium environment: PID 1 sets this on itself at boot;
# every service/session inherits it. Hand-edit freely — this file,
# not the compiled-in default, is the live source of truth once it
# exists.
[Profile]
MUSL_TRIPLE = "x86_64-zainium-linux-musl"
MUSL_SYSDIR = "/overlayer/syshub/x86_64-zainium-linux-musl"
MUSL_LIB = "/overlayer/syshub/x86_64-zainium-linux-musl/lib"
MUSL_LD = "/overlayer/syshub/x86_64-zainium-linux-musl/lib/ld-musl-x86_64.so.1"
OXIDIZED_ENV = "1"
NO_FHS = "1"
# The one canonical, resolved path to `sh` — anything that generates a
# shebang or execs a shell script explicitly should read this instead of
# hardcoding the path, so it stays in sync if syshub's layout ever changes.
RESOLVED_SH = "/overlayer/syshub/bin/sh"
PATH = "/overlayer/syshub/bin:/overlayer/syshub/sbin:/overlayer/syshub/x86_64-zainium-linux-musl/bin:/overlayer/zexlib/union/bin"
LD_LIBRARY_PATH = "/overlayer/syshub/lib:/overlayer/syshub/x86_64-zainium-linux-musl/lib:/overlayer/zexlib/union/lib"
LANG = "C.UTF-8"
LC_ALL = "C.UTF-8"
